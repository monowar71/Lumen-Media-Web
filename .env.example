# Base URL of the FreePlex server API root.
# Leave empty to derive from the page host (LAN-friendly) or configure on Login/Settings.
# Example for a fixed LAN address: VITE_API_BASE_URL=http://192.168.0.92:8096
VITE_API_BASE_URL=

# Set to "true" to start Mock Service Worker in the browser (dev without a backend).
VITE_ENABLE_MOCKS=false
